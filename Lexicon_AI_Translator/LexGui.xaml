            <!--Views-->
            <Border Grid.Column="1" CornerRadius="0 9 9 0" Background="#FF282828">
                
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <MatrixAnimationUsingPath
                        Storyboard.TargetName="LightDot1Transform"
                        Storyboard.TargetProperty="Matrix"
                        Duration="0:0:2.5"
                        RepeatBehavior="Forever">
                                    <MatrixAnimationUsingPath.PathGeometry>
                                        <PathGeometry Figures="M118,673 L508,673 L801,397"/>
                                    </MatrixAnimationUsingPath.PathGeometry>
                                </MatrixAnimationUsingPath>
                                <DoubleAnimationUsingKeyFrames
                        Storyboard.TargetName="LightDot1"
                        Storyboard.TargetProperty="Opacity"
                        Duration="0:0:2.5"
                        RepeatBehavior="Forever">
                                    <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0.3"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:2.1" Value="0.3"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:2.5" Value="0"/>
                                </DoubleAnimationUsingKeyFrames>

                                <MatrixAnimationUsingPath
                        Storyboard.TargetName="LightDot2Transform"
                        Storyboard.TargetProperty="Matrix"
                        Duration="0:0:2.5"
                        RepeatBehavior="Forever">
                                    <MatrixAnimationUsingPath.PathGeometry>
                                        <PathGeometry Figures="M208,843 L598,843 L891,567"/>
                                    </MatrixAnimationUsingPath.PathGeometry>
                                </MatrixAnimationUsingPath>
                                <DoubleAnimationUsingKeyFrames
                        Storyboard.TargetName="LightDot2"
                        Storyboard.TargetProperty="Opacity"
                        Duration="0:0:2.5"
                        RepeatBehavior="Forever">
                                    <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0.3"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:2.1" Value="0.3"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:2.5" Value="0"/>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">


                   
                    <StackPanel Orientation="Horizontal">
                        <Label Grid.Row="0" FontWeight="ExtraBold" FontSize="50">
                            <Label.Foreground>
                                <LinearGradientBrush SpreadMethod="Repeat">
                                    <LinearGradientBrush.Transform>
                                        <TranslateTransform x:Name="LinearGradientBrushAnim" />
                                    </LinearGradientBrush.Transform>
                                    <LinearGradientBrush.GradientStops>
                                        <GradientStop Offset="0.00" Color="#FFD5A204" />
                                        <GradientStop Offset="0.20" Color="#FFF2CA06" />
                                        <GradientStop Offset="0.40" Color="#FFC0B438" />
                                        <GradientStop Offset="0.60" Color="#FFF2EAC2" />
                                        <GradientStop Offset="0.80" Color="#FFEDE220" />
                                        <GradientStop Offset="1.00" Color="#FFFFF4D1" />

                                        <GradientStop Offset="2.00" Color="#FFD5A204" />
                                        <GradientStop Offset="2.20" Color="#FFF2CA06" />
                                        <GradientStop Offset="2.40" Color="#FFC0B438" />
                                        <GradientStop Offset="2.60" Color="#FFF2EAC2" />
                                        <GradientStop Offset="2.80" Color="#FFEDE220" />
                                        <GradientStop Offset="3.00" Color="#FFFFF4D1" />
                                    </LinearGradientBrush.GradientStops>
                                </LinearGradientBrush>
                            </Label.Foreground>
