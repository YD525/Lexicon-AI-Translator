<Window x:Class="LexTranslator.DataBaseView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LexTranslator"
        mc:Ignorable="d"
        Title="DataBaseView" Height="450" Width="800" Background="#FF282828">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Label VerticalAlignment="Center" Foreground="White">
                Table: AdvancedDictionary
            </Label>
            <Label VerticalAlignment="Center" Foreground="White">
                SQL:
            </Label>
            <TextBox Name="SqlOrder" Width="300" VerticalContentAlignment="Center" BorderThickness="1" BorderBrush="White" Background="{x:Null}" Foreground="White" CaretBrush="White">
            </TextBox>
            <Button x:Name="QueryBtn" Margin="5 0 0 0" Content="Query" Width="110" Height="34"
         Background="#1A1E2E" Foreground="#FF0B74D1"
         BorderBrush="#FF0B74D1" BorderThickness="1"
         FontSize="12"
         Cursor="Hand" 
         Click="QueryDataBase"/>
        </StackPanel>
    </Grid>
</Window>
