<UserControl x:Class="LexTranslator.YDControls.MainChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LexTranslator.YDControls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#0C0E14" Loaded="UserControl_Loaded">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="SYSTEM MONITOR"
                       Foreground="White" FontSize="22" FontWeight="Bold"
                       FontFamily="Segoe UI"/>
            <TextBlock Text="Real-time performance dashboard"
                       Foreground="#555E6E" FontSize="12" FontFamily="Segoe UI"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Chart 1: CPU -->
        <Border Grid.Row="1" Margin="0,0,0,12"
                Background="#0F1119" CornerRadius="10"
                BorderBrush="#1E2230" BorderThickness="1">
            <local:RealtimeLineChart
                x:Name="GpuChart"
                Title="Gpu USAGE"
                Unit="%"
                MinValue="0" MaxValue="100"
                MaxPoints="80"
                LineColor="#00C8A0"
                BackgroundColor="#0F1119"
                GridColor="#1E2230"
                LabelColor="#445060"
                LineThickness="2"
                GridRows="4" GridColumns="8"
                ShowFill="True"
                ShowDot="True"
                RefreshInterval="600"/>
        </Border>

        <!-- Chart 2: Memory -->
        <Border Grid.Row="2" Margin="0,0,0,12"
                Background="#0F1119" CornerRadius="10"
                BorderBrush="#1E2230" BorderThickness="1">
            <local:RealtimeLineChart
                x:Name="TokenChart"
                Title="Token Usage"
                Unit="Tokens"
                MinValue="0" MaxValue="0"
                MaxPoints="80"
                LineColor="#5B8EFF"
                BackgroundColor="#0F1119"
                GridColor="#1E2230"
                LabelColor="#445060"
                LineThickness="2"
                GridRows="4" GridColumns="8"
                ShowFill="True"
                ShowDot="True"
                RefreshInterval="800"/>
        </Border>

        <!-- Controls -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="BtnPause" Content="⏸  PAUSE"
                    Click="BtnPause_Click"
                    Width="110" Height="34"
                    Background="#1A1E2E" Foreground="#00C8A0"
                    BorderBrush="#00C8A0" BorderThickness="1"
                    FontSize="12" FontFamily="Segoe UI"
                    Cursor="Hand" Margin="0,0,12,0"/>
            <Button x:Name="BtnClear" Content="✕  CLEAR"
                    Click="BtnClear_Click"
                    Width="110" Height="34"
                    Background="#1A1E2E" Foreground="#FF5B6A"
                    BorderBrush="#FF5B6A" BorderThickness="1"
                    FontSize="12" FontFamily="Segoe UI"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</UserControl>
