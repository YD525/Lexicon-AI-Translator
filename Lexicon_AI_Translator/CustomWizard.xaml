<Window x:Class="LexTranslator.CustomWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LexTranslator"
        mc:Ignorable="d"
        Title="CustomTranslationPlatformWizard" Height="700" Width="750" WindowStartupLocation="CenterScreen">
    <Grid Background="#FF424242">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="5 0 5 0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Label VerticalAlignment="Center" FontSize="17" FontWeight="DemiBold" Foreground="White" Background="#FF2F2F2F">
                    1/3
                </Label>

                <Label Name="Tittle" FontSize="13" VerticalAlignment="Center" Foreground="White">
                    Add Translation Platform – Select Platform Type
                </Label>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="5 0 5 0" VerticalAlignment="Center">
            <Grid Name="View1st" Visibility="Hidden">
                <StackPanel Orientation="Vertical">
                    <TextBox BorderThickness="0" BorderBrush="{x:Null}" IsReadOnly="True" Background="{x:Null}" Foreground="White" CaretBrush="White" TextWrapping="Wrap" AcceptsReturn="True">
                        Select the type of translation platform you want to add. Please make sure to select the correct one from the drop-down menu below, whether it's an AI platform or a traditional translation platform.
                    </TextBox>
                    <StackPanel Orientation="Horizontal" Margin="0 10 0 0" HorizontalAlignment="Center">
                        <Label Foreground="White">
                            Platform Type
                        </Label>
                        <ComboBox Width="100" VerticalContentAlignment="Center">
                            AI Platform
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Name="View2nd" Visibility="Hidden">
                <StackPanel Orientation="Vertical">
                    <TextBox BorderThickness="0" BorderBrush="{x:Null}" IsReadOnly="True" Background="{x:Null}" Foreground="White" CaretBrush="White" TextWrapping="Wrap" AcceptsReturn="True">
                        You need to configure the request URL, header, and payload (Request Body). Refer to the SDK documentation for the translation platform you want to integrate with to fill in these fields appropriately. After filling them in, you need to select the object to be included in the automatic fields on the right side of each field and click the "Automatic Fields" list. This will set the specific placeholders in the designated fields. Click the "test" button to verify whether the interface can return a response normally.
                    </TextBox>
                    <Label Foreground="White" Margin="0 5 0 0">
                        Automatic Fields
                    </Label>
                    <ListBox Background="#FF5F5F5F" Name="AutomaticFields" VerticalContentAlignment="Center" Height="50">

                    </ListBox>

                    <Label Foreground="White">
                        Test ApiKey
                    </Label>
                    <TextBox>
                    </TextBox>

                    <Label Foreground="White">
                        URL
                    </Label>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBox Grid.Column="0" TextWrapping="Wrap" AcceptsReturn="True" Height="50" ScrollViewer.VerticalScrollBarVisibility="Auto">

                        </TextBox>
                        
                        <ListBox Grid.Column="1" BorderBrush="{x:Null}" Background="#FF5F5F5F">
                        </ListBox>
                    </Grid>
                   


                    <Label Foreground="White">
                        Header
                    </Label>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" TextWrapping="Wrap" AcceptsReturn="True" Height="50" ScrollViewer.VerticalScrollBarVisibility="Auto">

                        </TextBox>

                        <ListBox Grid.Column="1" BorderBrush="{x:Null}" Background="#FF5F5F5F">
                        </ListBox>
                    </Grid>


                    <Label Foreground="White">
                        Payload (Request Body)
                    </Label>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" TextWrapping="Wrap" AcceptsReturn="True" Height="50" ScrollViewer.VerticalScrollBarVisibility="Auto">

                        </TextBox>

                        <ListBox Grid.Column="1" BorderBrush="{x:Null}" Background="#FF5F5F5F">
                        </ListBox>
                    </Grid>

                    <Border Name="TestCallBtn" CornerRadius="6" BorderThickness="1" BorderBrush="White" Background="#FF2F2F2F" Cursor="Hand" Margin="0 5 0 5">
                        <Label Foreground="White" VerticalAlignment="Center" IsHitTestVisible="False" HorizontalAlignment="Center">
                            Test Call
                        </Label>
                    </Border>
                    
                    <Label Foreground="White">
                        Response
                    </Label>
                    <TextBox IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="50" Foreground="White" Background="{x:Null}" BorderThickness="0" BorderBrush="{x:Null}" ScrollViewer.VerticalScrollBarVisibility="Auto">

                    </TextBox>

                </StackPanel>
            </Grid>

            <Grid Name="View3rd" Visibility="Visible">
                <StackPanel Orientation="Vertical">

                    <TextBox BorderThickness="0" BorderBrush="{x:Null}" IsReadOnly="True" Background="{x:Null}" Foreground="White" CaretBrush="White" TextWrapping="Wrap" AcceptsReturn="True">
                        We now need to define a rule to extract the content returned by the request.
                        Note that if the returned content is JSON, you only need to select FieldName and leave the other fields blank. If the returned content is not JSON, the following two methods are provided: Extract Between,Extract After.
                    </TextBox>

                    <Label Foreground="White" Margin="0 5 0 0">
                        Response (Click on the ListBox on the right to apply the field to FieldName)
                    </Label>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" TextWrapping="Wrap" AcceptsReturn="True" Height="300" ScrollViewer.VerticalScrollBarVisibility="Auto">

                        </TextBox>

                        <ListBox Grid.Column="1" BorderBrush="{x:Null}" Background="#FF5F5F5F">
                        </ListBox>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <CheckBox Foreground="White" Margin="0 5 0 5" IsChecked="True">
                            IsJson
                        </CheckBox>
                        <Label Foreground="#FF04B7E5">
                            FieldName:
                        </Label>
                    </StackPanel>

                    <TextBox BorderThickness="0" BorderBrush="{x:Null}" IsReadOnly="True" Background="{x:Null}" Foreground="White" CaretBrush="White" TextWrapping="Wrap" AcceptsReturn="True">
                        If the API returns content that is not JSON, the following are special handling strategies.
                    </TextBox>
                    
                    <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                        <Label Foreground="White">
                            Extract Between
                        </Label>
                        <TextBox Width="100" Margin="0 0 5 0">
                        </TextBox>
                        <TextBox Width="100">
                        </TextBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                        <Label Foreground="White">
                            Extract After
                        </Label>
                        <TextBox Width="100">
                        </TextBox>
                    </StackPanel>

                    <Border Name="TestGetResponseBtn" CornerRadius="6" BorderThickness="1" BorderBrush="White" Background="#FF2F2F2F" Cursor="Hand" Margin="0 5 0 5">
                        <Label Foreground="White" VerticalAlignment="Center" IsHitTestVisible="False" HorizontalAlignment="Center">
                            Test Call
                        </Label>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" HorizontalAlignment="Right" Margin="5 0 5 0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Name="CancelBtn" CornerRadius="6" BorderThickness="1" BorderBrush="White" Background="#FF2F2F2F" Cursor="Hand" Margin="0 0 5 0">
                    <Label Foreground="White" VerticalAlignment="Center" IsHitTestVisible="False">
                        Cancel
                    </Label>
                </Border>

                <Border Name="BackBtn" CornerRadius="6" BorderThickness="1" BorderBrush="White" Background="#FF2F2F2F" Cursor="Hand" Margin="0 0 5 0" Visibility="Collapsed">
                    <Label Foreground="White" VerticalAlignment="Center" IsHitTestVisible="False">
                        Back
                    </Label>
                </Border>

                <Border Name="NextBtn" CornerRadius="6" BorderThickness="1" BorderBrush="White" Background="#FF2F2F2F" Cursor="Hand">
                    <Label Foreground="White" VerticalAlignment="Center" IsHitTestVisible="False">
                        Next
                    </Label>
                </Border>

                <Border Name="FinishBtn" CornerRadius="6" BorderThickness="1" BorderBrush="White" Background="#FF2F2F2F" Cursor="Hand" Margin="0 0 5 0" Visibility="Collapsed">
                    <Label Foreground="White" VerticalAlignment="Center" IsHitTestVisible="False">
                        Finish
                    </Label>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
